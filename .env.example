# Copy to .env (gitignored). SQL Server needs 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=

# Optional: comma-separated Entra object ids allowed to sign in. migrate creates a User row for each.
AUTH_ALLOWED_OIDS=

# Optional: requests a minute per address, static files included (default 100). The Playwright suite sets 2000 when
# it starts the stack itself; set it here when the stack it runs against was started by hand.
RATE_LIMIT_PERMIT=
