# Copy to .env (gitignored). SQL Server needs 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=

# Optional: Google sign-in (docs/google_sign_in_setup.md). Both or neither; without them the stack is demo-only.
# The client's authorised redirect URIs must include http://localhost:8080/auth/callback. Never commit a real secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: requests a minute per address, static files included (default 100). The Playwright suite sets 2000 when
# it starts the stack itself; set it here when the stack it runs against was started by hand.
RATE_LIMIT_PERMIT=
